# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/mybeaufortview
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme

# JWT
# Replace with a Base64-encoded secret representing at least 256 bits.
JWT_SECRET=REPLACE_WITH_BASE64_256_BIT_SECRET

# AWS / S3
# S3 integration is disabled by default for local development.
AWS_S3_BUCKET=mybeaufortview-dev
AWS_S3_REGION=us-east-1
AWS_S3_ENABLED=false

# OpenAI
# Replace with a real API key in your local .env file.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
